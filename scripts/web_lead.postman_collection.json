          "raw": "{\n  \"form_type\": \"evaluation\",\n  \"first_name\": \"Arun\",\n  \"email\": \"{{dup_email}}\",\n  \"mobile_no\": \"{{rand_mobile}}\",\n  \"course_level\": \"Masters\",\n  \"preferred_state\": \"Victoria\"\n}",
