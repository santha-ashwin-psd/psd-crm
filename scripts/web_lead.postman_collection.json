        "description": "RUN REQUEST 1 FIRST.\n\nSame person, second form, different phone. No new lead is created \u2014 the evaluation answers are attached to the existing lead as a note. Returns duplicate:true, which is a success."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json().message;",
              "pm.test('duplicate:true is still success:true', () => {",
              "    pm.expect(b.success).to.be.true;",
              "    pm.expect(b.duplicate).to.be.true;",
              "});",
              "const first = pm.collectionVariables.get('first_lead');",
              "if (first) {",
              "    pm.test('points at the SAME lead as request 1', () => pm.expect(b.lead).to.eql(first));",
              "} else {",
              "    console.log('run request 1 first to assert the lead name matches');",
              "}"
            ]
          }
        }
      ]
    },
